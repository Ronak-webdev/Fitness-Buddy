# ----- Environment & Secrets -------------------------------------------------
.env
.env.local
.env.*.local
*.env

# ----- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
*.egg
.venv/
venv/
env/
ENV/
pip-wheel-metadata/
.pytest_cache/
.coverage
htmlcov/
.tox/
*.xml
junit*.xml

# ----- Node / Frontend --------------------------------------------------------
node_modules/
frontend/dist/
frontend/build/
frontend/.vite/
*.tsbuildinfo

# ----- OS ---------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini

# ----- IDEs -------------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*.sublime-workspace

# ----- Docker -----------------------------------------------------------------
*.pid

# ----- Logs -------------------------------------------------------------------
*.log
logs/
